<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sajda needs your location to accurately calculate prayer times.</string>
	<key>NSLocationUsageDescription</key>
	<string>Sajda needs your location to accurately calculate prayer times.</string>
	<key>LSUIElement</key>
	<true/>
	<key>RunAtLogin</key>
	<true/>
	<!-- No automatic updater in this independent fork until it has its own
         signing key and feed. Never use the upstream appcast. -->
    <key>SUEnableAutomaticChecks</key>
    <false/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
</dict>
</plist>
